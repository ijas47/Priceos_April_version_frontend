# Database
MONGODB_URI=
DATABASE_NAME=priceos

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=
AGENT_TOOLS_JWT_SECRET=

# API URL (use /api for self-hosted, or absolute URL for external backend)
NEXT_PUBLIC_API_URL=/api

# External APIs
LYZR_API_KEY=
LYZR_API_URL=
LYZR_STREAM_URL=
LYZR_BASE_URL=
LYZR_UPLOAD_URL=
LYZR_RAG_BASE_URL=
LYZR_RAG_CRAWL_URL=
LYZR_CONTEXT_ID=
HOSTAWAY_API_BASE_URL=
HOSTAWAY_API_KEY=
HOSTAWAY_MODE=db
# Revenue optimization: ENABLED by default — the elasticity + demand layer
# DRIVES the proposed price (always clamped to each listing's floor/ceiling and
# capped to ±25% of the rulebook price; with no booking history it collapses
# back to the rulebook price). Set to "off" to revert to SHADOW mode, where the
# optimized price is only recorded per day (elasticityPrice) for comparison.
ELASTICITY_PRICING=on
# Blocks ALL pricing/calendar pushes to Hostaway. Keep true.
HOSTAWAY_READ_ONLY=true
# SEPARATE switch for guest-message delivery. When true, reviewed inbox
# replies are delivered to the guest via Hostaway. Pricing stays blocked by
# HOSTAWAY_READ_ONLY regardless. Keep false until verified with live creds.
HOSTAWAY_ALLOW_GUEST_SEND=false
# Shared secret for the inbound Hostaway webhook (/api/webhooks/hostaway).
# Required for the webhook to accept traffic (fail-closed).
HOSTAWAY_WEBHOOK_SECRET=
PYTHON_BACKEND_URL=

# Lyzr agent IDs
AGENT_ID=
LYZR_DASHBOARD_AGENT_ID=
LYZR_CRO_ROUTER_AGENT_ID=
LYZR_PROPERTY_ANALYST_AGENT_ID=
LYZR_BOOKING_INTELLIGENCE_AGENT_ID=
LYZR_MARKET_RESEARCH_AGENT_ID=
LYZR_PRICE_GUARD_AGENT_ID=
LYZR_MARKETING_AGENT_ID=
LYZR_BENCHMARK_AGENT_ID=
LYZR_GUARDRAILS_AGENT_ID=
LYZR_CONVERSATION_SUMMARY_AGENT_ID=
LYZR_CHAT_RESPONSE_AGENT_ID=

# Legacy alias support
Marketing_Agent_ID=
LYZR_Conversation_Summary_Agent_ID=
LYZR_Chat_Response_Agent_ID=
LYZR_Competitor_Benchmark_Agent_ID=
Lyzr_Guardrail_Agent_for_Floor_Ceiling_Values=

# Optional external feeds
EVENTBRITE_API_KEY=
DTCM_API_KEY=
TICKETMASTER_API_KEY=
PERPLEXITY_API_KEY=
SERP_API_KEY=
NEWS_API_KEY=

# Airbtics Market Intelligence
AIRBTICS_API_KEY=

# Vercel Cron — nightly market intel refresh (Authorization: Bearer <secret>)
CRON_SECRET=

# Demo seed credentials
DEMO_EMAIL=
DEMO_PASSWORD=
