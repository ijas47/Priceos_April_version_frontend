{
  "base_url": "${AGENT_TOOLS_BASE_URL}/api/guest-agent",
  "default_headers": {
    "Content-Type": "application/json"
  },
  "default_query_params": {
    "apiKey": "${AGENT_TOOLS_API_KEY}"
  },
  "default_body_params": {},
  "endpoint_defaults": {},
  "enhance_descriptions": false,
  "model_override": "gemini/gemini-3-flash-preview",
  "tool_filter": {
    "context": "guest",
    "allowed_operations": [
      "listThreads",
      "readThread",
      "sendGuestMessage",
      "createOpsTicket",
      "escalateThread",
      "closeThread",
      "sendAccessDetails",
      "getPropertyData",
      "sendUpsellOffer"
    ]
  }
}
